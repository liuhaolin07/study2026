{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: Build active file",
            "command": "cmd",
            "args": [
                "/c",
                "if /I \"${fileExtname}\"==\".c\" (\"D:\\app_edge\\w64devkit\\bin\\gcc.exe\" -fdiagnostics-color=always -g -std=c17 -O0 -Wall -Wextra -finput-charset=UTF-8 -fexec-charset=UTF-8 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\") else (\"D:\\app_edge\\w64devkit\\bin\\g++.exe\" -fdiagnostics-color=always -g -std=c++17 -O0 -Wall -Wextra -finput-charset=UTF-8 -fexec-charset=UTF-8 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\")"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build the active C or C++ file with GCC/G++."
        },
        {
            "type": "shell",
            "label": "C/C++: Build and run active file",
            "command": "cmd",
            "dependsOn": "C/C++: Build active file",
            "args": [
                "/c",
                "chcp 65001>nul && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "D:\\app_edge\\w64devkit\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}