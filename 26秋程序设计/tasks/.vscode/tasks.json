{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build active file",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if /I \"${fileExtname}\"==\".c\" (\"D:\\app_edge\\w64devkit\\bin\\gcc.exe\" -fdiagnostics-color=always -g -std=c17 -O0 -Wall -Wextra -finput-charset=UTF-8 -fexec-charset=UTF-8 \"${fileBasename}\" -o \"${fileBasenameNoExtension}.exe\") else (\"D:\\app_edge\\w64devkit\\bin\\g++.exe\" -fdiagnostics-color=always -g -std=c++17 -O0 -Wall -Wextra -finput-charset=UTF-8 -fexec-charset=UTF-8 \"${fileBasename}\" -o \"${fileBasenameNoExtension}.exe\")"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Compile the active C++ file with GCC and C++17."
        },
        {
            "label": "C++: Build and run active file",
            "type": "shell",
            "command": "cmd",
            "dependsOn": "C++: Build active file",
            "args": [
                "/c",
                "chcp 65001>nul && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
