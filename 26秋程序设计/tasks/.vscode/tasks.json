{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build active file",
            "type": "process",
            "command": "D:/app_edge/w64devkit/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-gdwarf-4",
                "-O0",
                "-Wall",
                "-Wextra",
                "-fdiagnostics-color=always",
                "${fileBasename}",
                "-o",
                "${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Compile the active C++ file with GCC and C++17."
        },
        {
            "label": "C++: Build and run active file",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C++: Build active file",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
