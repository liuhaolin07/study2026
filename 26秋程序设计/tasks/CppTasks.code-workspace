{
    "folders": [
        {
            "name": "tasks",
            "path": "D:/cpp-workspaces/cpp-tasks"
        }
    ],
    "settings": {
        "C_Cpp.default.compilerPath": "D:/app_edge/w64devkit/bin/g++.exe",
        "C_Cpp.default.cppStandard": "c++17",
        "debug.onTaskErrors": "abort"
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "C++: Debug active file (GDB)",
                "type": "cppdbg",
                "request": "launch",
                "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
                "args": [],
                "cwd": "${fileDirname}",
                "preLaunchTask": "C++: Build active file",
                "MIMode": "gdb",
                "miDebuggerPath": "D:/app_edge/w64devkit/bin/gdb.exe",
                "externalConsole": false,
                "stopAtEntry": false,
                "environment": [
                    {
                        "name": "PATH",
                        "value": "D:\\app_edge\\w64devkit\\bin;${env:PATH}"
                    }
                ],
                "setupCommands": [
                    {
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        ]
    }
}
